# Nothing that could carry a credential. The Foundry key is a SPEND credential: it is read from
# ../studio/.env.local at run time, held in one variable, and never written here.
.env
.env.*
*.env

# Review scaffolding. Contact sheets are built from the assets on demand and are not artefacts.
review/

# Python and editor debris.
__pycache__/
*.pyc
.DS_Store

# Managed Compute deployment windows are recorded per candidate in
# candidates/<id>/DEPLOYMENT.json and ARE committed — the bill is wall-clock, so when the
# deployment existed is provenance. Nothing else about a candidate endpoint is: the scoring URI
# and its key live only in the gitignored studio/.env.local.
